@startuml
title teper_elecciones - Diagrama entidad-relacion (PASO 2023)

hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

entity "PARTIDOS POLITICOS 2023" as Partido2023 {
  * codigo : INT <<PK>>
  --
  nro_partido : VARCHAR(10)
  descripcion : VARCHAR(255)
  cod_jurisdiccion : INT
  cod_localidad : INT
  color_primario : VARCHAR(20)
  color_secundario : VARCHAR(20)
}

entity "LISTAS PASO 2023" as Lista2023 {
  * codigo : INT <<PK>>
  --
  cod_partido : INT <<indice>>
  nro : VARCHAR(6)
  descripcion : VARCHAR(255)
  cod_jurisdiccion : INT
  cod_cargo_electivo : INT
  cod_seccion : INT
  cod_localidad : INT
}

entity "CANDIDATOS PASO 2023" as Candidato2023 {
  * codigo : INT <<PK>>
  --
  cod_lista : INT <<FK>>
  cod_cargo : INT <<FK>>
  orden : INT
  apellido : VARCHAR(60)
  nombre : VARCHAR(80)
  nro_doc : INT
  genero : CHAR(1)
  cod_departamento_candidato : INT <<FK>>
  cod_localidad_candidato : INT <<FK>>
}

entity "CARGOS" as Cargo {
  * codigo : INT <<PK>>
  --
  descripcion : VARCHAR(100)
}

entity "SECCIONES" as Seccion {
  * codigo : INT <<PK>>
  --
  descripcion : VARCHAR(255)
}

entity "LOCALIDADES 2023" as Localidad2023 {
  * codigo : INT <<PK>>
  --
  descripcion : VARCHAR(255)
}

Partido2023 ||--o{ Lista2023 : "cod_partido (relacion logica)"
Lista2023 ||--o{ Candidato2023 : "FK cod_lista"
Cargo ||--o{ Candidato2023 : "FK cod_cargo"
Seccion ||--o{ Candidato2023 : "FK cod_departamento_candidato"
Localidad2023 ||--o{ Candidato2023 : "FK cod_localidad_candidato"

note bottom of Lista2023
  Alcance temporal validado: PASO 2023.
  1.004 listas; todas poseen un partido existente.
  42 partidos distintos tienen listas.
end note

note bottom of Candidato2023
  15.247 candidatos; todos poseen una lista existente.
  Las 1.004 listas tienen candidatos.
  Antes de aplicar la FK de departamento deben corregirse
  219 registros con cod_departamento_candidato = 0.
end note

legend bottom
  |= Linea |= Significado |
  | Solida | Relacion del dominio |
  | FK | Clave foranea del modelo propuesto |
  | Relacion logica | Validada con datos, pero no declarada como FK |
endlegend
@enduml
